# ENSO Intelligence Platform: credential template.
# Copy to `.env` and fill in. Loaded via python-dotenv. NEVER commit `.env`.
# All Phase 1 sources (ONI, Pink Sheet, advisory) are free and need NO keys.
# These are only required for Phase 2 data sources.

# Copernicus Climate Data Store (ERA5 SST grids) — register at
# https://cds.climate.copernicus.eu/  (key also goes in ~/.cdsapirc)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# USDA NASS Quick Stats (US crop yields) — free key at
# https://quickstats.nass.usda.gov/api
USDA_NASS_API_KEY=

# EM-DAT disaster database. NOT read by any code, and deliberately so: neither the
# portal nor the HDX mirror permits automated download, so data/ingest/emdat_disasters.py
# scans a hand-placed export in data/raw/emdat instead. These names are kept only to
# document how that export is obtained. Register at https://public.emdat.be/ and
# download once by hand.
#EMDAT_USERNAME=
#EMDAT_PASSWORD=

# --- Evaluated but NOT wired. See docs/RESOURCES.md for endpoints and the reasoning. ---
# No code reads either of these yet. Setting them does nothing today.
#DATA_GOV_IN_API_KEY=      # data.gov.in (Agmarknet mandi prices, reservoir storage)
#FRED_API_KEY=             # FRED / IMF commodity price series, free key
